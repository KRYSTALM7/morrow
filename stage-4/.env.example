# Create a Sandbox REST app in developer.paypal.com, then paste its Sandbox credentials here.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_MERCHANT_LABEL=Morrow Sandbox merchant
POCKETFUL_PUBLIC_URL=http://localhost:8080
# Optional; defaults to PAYPAL_DB_PATH so finance and PayPal records share the mounted /data volume.
MORROW_FINANCE_DB_PATH=/data/paypal.sqlite3
MORROW_WALLET_DB_PATH=/data/paypal-wallet.sqlite3
# Optional one-time import of a pre-migration Stage 4 /_test/export JSON snapshot.
MORROW_WALLET_MIGRATION_FILE=
# Optional server-side financial companion. Leave the key unset for deterministic fallback.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
